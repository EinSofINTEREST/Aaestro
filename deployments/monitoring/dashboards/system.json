{
  "title": "Aaestro — System",
  "uid": "aaestro-system",
  "description": "Container counts, memory service load, index lag",
  "panels": [
    {
      "title": "Containers running by agent",
      "type": "timeseries",
      "targets": [
        {
          "expr": "aaestro_containers_running"
        }
      ]
    },
    {
      "title": "Restart rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (agent) (rate(aaestro_container_restarts_total[15m]))"
        }
      ]
    },
    {
      "title": "Memory operations",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (space, op, status) (rate(aaestro_memory_operations_total[5m]))"
        }
      ]
    },
    {
      "title": "Memory search latency p95",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, space) (rate(aaestro_memory_search_duration_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "title": "Memory entries per space",
      "type": "timeseries",
      "targets": [
        {
          "expr": "aaestro_memory_entries"
        }
      ]
    },
    {
      "title": "Index lag",
      "type": "timeseries",
      "targets": [
        {
          "expr": "aaestro_memory_index_lag_seconds"
        }
      ]
    },
    {
      "title": "Access decisions by outcome and source",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (resource, decision, source) (rate(aaestro_access_decisions_total[5m]))"
        }
      ]
    },
    {
      "title": "Grants, revocations and refusals",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (op, decided_by) (increase(aaestro_access_grants_total[1h]))"
        }
      ]
    },
    {
      "title": "Registry reachable per enforcement point",
      "type": "stat",
      "targets": [
        {
          "expr": "aaestro_access_registry_reachable"
        }
      ]
    },
    {
      "title": "Decision cache invalidations",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (component) (rate(aaestro_access_cache_invalidations_total[5m]))"
        }
      ]
    }
  ]
}
